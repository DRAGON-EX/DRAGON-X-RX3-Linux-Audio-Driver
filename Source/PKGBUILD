# Local project sources; no network retrieval or dependency installation.
pkgname=dragon-x-rx3-audio-driver
pkgver=0.1.3
pkgrel=1
pkgdesc='Four-channel 24-bit ALSA playback driver for Pioneer XDJ-RX3'
arch=('x86_64')
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=('alsa-lib' 'libusb' 'json-c' 'systemd' 'python' 'python-gobject' 'gtk3' 'util-linux' 'wine' 'pipewire' 'pipewire-pulse' 'wireplumber' 'glibc')
conflicts=('rx3-audio-driver' 'pipeasio' 'pipeasio-git' 'pipeasio-rx3' 'pipeasio-rx3-test')
makedepends=('gcc' 'make' 'pkgconf' 'cmake' 'clang' 'lld')
install=rx3.install
options=('!debug' '!lto' '!strip')
source=('rx3-audio-driver-0.1.3.tar.gz' 'pipeasio-rx3-1.10.0.tar.gz' 'rx3-asio-register.py' 'rx3.install' 'REGISTRAR-LICENSE')
sha256sums=('911f22c0d76ff422df0ca6f764ac4a0eab16b517a7b7c820e72b976980efb328' 'ac0331bd1c74776e416e229c02fd2f9a2fd52213e2c52077ddbdc8f46d4038dc' 'cea398630b9e5287685057f1e31eea6a358091df0911e8d37a3369d75bcecafb' 'cb62f780c8b5d551061d79045838803e0f4bd7e1d61e145b5859c2b71dd9cb9c' '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

build() {
    cd "$srcdir/rx3-audio-driver-$pkgver"
    make CFLAGS="$CFLAGS -std=c11 -Wall -Wextra -Werror -fPIC -DPIC" LDFLAGS="$LDFLAGS"
    cmake -S "$srcdir/pipeasio-rx3" -B "$srcdir/pipeasio-build" -DBUILD_SETTINGS_PANEL=OFF -DBUILD_MANAGER=OFF -DBUILD_ARM64=OFF -DBUILD_TESTS=ON -DPIPEASIO_PE_COMPILER=clang -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/pipeasio-build" --parallel 4
}

check() {
    cd "$srcdir/rx3-audio-driver-$pkgver"
    python3 -m unittest discover -s tests -v
    python3 packaging/package_selftest.py --plugin-dir . --helper ./test_pcm --poll-helper ./test_poll --ring-helper ./test_ring --drain-helper ./test_drain
    ctest --test-dir "$srcdir/pipeasio-build" --output-on-failure -R '^(test_|unix_abi_layout|register_script|wine_install_root_relative)'
}

package() {
    cd "$srcdir/rx3-audio-driver-$pkgver"
    install -Dm755 libasound_module_pcm_rx3.so "$pkgdir/usr/lib/alsa-lib/libasound_module_pcm_rx3.so"
    install -Dm755 test_pcm "$pkgdir/usr/lib/rx3-audio-driver/test_pcm"
    install -Dm755 test_poll "$pkgdir/usr/lib/rx3-audio-driver/test_poll"
    install -Dm755 test_ring "$pkgdir/usr/lib/rx3-audio-driver/test_ring"
    install -Dm755 test_drain "$pkgdir/usr/lib/rx3-audio-driver/test_drain"
    install -Dm755 packaging/package_selftest.py "$pkgdir/usr/bin/rx3-audio-selftest"
    install -Dm644 packaging/99-rx3.conf "$pkgdir/usr/share/alsa/alsa.conf.d/99-rx3.conf"
    install -d "$pkgdir/etc/alsa/conf.d"
    ln -s /usr/share/alsa/alsa.conf.d/99-rx3.conf "$pkgdir/etc/alsa/conf.d/99-rx3.conf"
    install -Dm644 packaging/70-rx3-audio.rules "$pkgdir/usr/lib/udev/rules.d/70-rx3-audio.rules"
    install -Dm755 packaging/rx3_audio_setup.py "$pkgdir/usr/bin/rx3-audio-setup"
    install -Dm755 packaging/rx3_audio_settings.py "$pkgdir/usr/bin/rx3-audio-settings"
    install -Dm755 packaging/rx3_sessions.py "$pkgdir/usr/lib/rx3-audio-driver/rx3-sessions"
    install -Dm644 packaging/rx3-node.json "$pkgdir/usr/share/rx3-audio-driver/rx3-node.json"
    install -Dm644 packaging/90-rx3-audio.conf "$pkgdir/usr/share/pipewire/pipewire.conf.d/90-rx3-audio.conf"
    install -Dm644 packaging/pioneer-rx3-linux.desktop "$pkgdir/usr/share/applications/pioneer-rx3-linux.desktop"
    install -Dm644 packaging/pioneer-rx3-asio.desktop "$pkgdir/usr/share/applications/pioneer-rx3-asio.desktop"
    install -Dm644 packaging/pioneer-rx3-wasapi.desktop "$pkgdir/usr/share/applications/pioneer-rx3-wasapi.desktop"
    install -Dm644 packaging/rx3-audio-settings.service "$pkgdir/usr/lib/systemd/user/rx3-audio-settings.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 "$srcdir/pipeasio-build/x86_64-windows/pipeasio64.dll" "$pkgdir/usr/lib/wine/x86_64-windows/pipeasio64.dll"
    install -Dm755 "$srcdir/pipeasio-build/x86_64-unix/pipeasio64.so" "$pkgdir/usr/lib/wine/x86_64-unix/pipeasio64.so"
    install -Dm755 "$srcdir/rx3-asio-register.py" "$pkgdir/usr/bin/rx3-asio-register"
    install -Dm644 "$srcdir/REGISTRAR-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/REGISTRAR-LICENSE"
    install -Dm644 "$srcdir/pipeasio-rx3/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
    install -Dm644 "$srcdir/pipeasio-rx3/COPYING.LESSER" "$pkgdir/usr/share/licenses/$pkgname/COPYING.LESSER"
}
