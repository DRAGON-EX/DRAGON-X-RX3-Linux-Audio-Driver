+/* Called only by the host's control-panel action, never by bufferSwitch. */
+bool
+audio_launch_rx3_settings(void)
+{
+    pa_simple_params p = {0};
+    if (!ensure_unixlib()) return false;
+    p.version = PIPEASIO_UNIX_ABI_VERSION;
+    return UCALL(PAU_LAUNCH_RX3_SETTINGS, &p) == 0 && p.result != 0;
+}
