+/* RX3 integration uses a fixed user service, not a shell or a configurable
+ * command. systemd starts GTK with the desktop session environment, outside
+ * Wine's DLL/container environment. No USB operation or audio restart occurs.
+ * This optional bridge targets native system Wine on systemd desktops. */
+static NTSTATUS
+unix_launch_rx3_settings(void *args)
+{
+    pa_simple_params *p = args;
+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attrs;
+    struct sched_param normal = {0};
+    pid_t child;
+    int rc, status;
+    extern char **environ;
+    char *argv[] = {"/usr/bin/systemctl", "--user", "--no-block", "start",
+                    "rx3-audio-settings.service", NULL};
+    PAU_CHECK(p);
+    p->result = 0;
+    if (posix_spawn_file_actions_init(&actions)) return STATUS_SUCCESS;
+    if (posix_spawnattr_init(&attrs)) {
+        posix_spawn_file_actions_destroy(&actions);
+        return STATUS_SUCCESS;
+    }
+    rc = posix_spawn_file_actions_addclosefrom_np(&actions, 3);
+    if (!rc) rc = posix_spawnattr_setschedpolicy(&attrs, SCHED_OTHER);
+    if (!rc) rc = posix_spawnattr_setschedparam(&attrs, &normal);
+    if (!rc) rc = posix_spawnattr_setflags(&attrs, POSIX_SPAWN_RESETIDS |
+                      POSIX_SPAWN_SETSCHEDULER | POSIX_SPAWN_SETSCHEDPARAM);
+    if (!rc) rc = posix_spawn(&child, argv[0], &actions, &attrs, argv, environ);
+    posix_spawn_file_actions_destroy(&actions);
+    posix_spawnattr_destroy(&attrs);
+    if (rc) return STATUS_SUCCESS;
+    /* Bound UI-thread waiting and reap our own short-lived launcher. The GUI
+     * itself is a user service, so it does not remain a child of the ASIO host. */
+    for (unsigned i = 0; i < 150; ++i) {
+        pid_t got = waitpid(child, &status, WNOHANG);
+        if (got == child) {
+            p->result = WIFEXITED(status) && WEXITSTATUS(status) == 0;
+            return STATUS_SUCCESS;
+        }
+        if (got < 0 && errno != EINTR) return STATUS_SUCCESS;
+        struct timespec pause = {0, 20000000};
+        nanosleep(&pause, NULL);
+    }
+    kill(child, SIGKILL);
+    while (waitpid(child, &status, 0) < 0 && errno == EINTR) {}
+    return STATUS_SUCCESS;
+}
